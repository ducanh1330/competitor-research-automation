# Copy to .env and fill in. .env is gitignored; never put real keys in this file.
# Add one line per service as tools start needing them.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# FIRECRAWL_API_KEY=

# Google APIs (Sheets/Slides/Drive) use OAuth via credentials.json + token.json,
# not env vars. Download credentials.json from the Google Cloud console and place
# it in the repo root; token.json is written on first authorization.
